# ---- Shared ----
ENVIRONMENT=local

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_governance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- OPA ----
OPA_URL=http://localhost:8181

# ---- Gateway (Go) ----
GATEWAY_PORT=8080
GATEWAY_AGENT_API_KEY_HEADER=X-Agent-Api-Key

# ---- Control Plane (Spring Boot) ----
CONTROL_PLANE_PORT=8081
JWT_SECRET=replace-with-a-real-secret-before-deploying

# ---- Agent Runner (Python) ----
AGENT_RUNNER_PORT=8000
GATEWAY_BASE_URL=http://localhost:8080

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8081
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
